# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_mongodb_password

# Graylog Configuration
# IMPORTANT: Change these values before deploying to production!

# Password secret (must be at least 16 characters)
# Generate with: pwgen -N 1 -s 96
GRAYLOG_PASSWORD_SECRET=somepasswordpepper_change_this_to_a_long_random_string

# Root password (SHA2 hash of your desired password)
# Default password is "admin" - CHANGE THIS!
# Generate with: echo -n "yourpassword" | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# External URI for Graylog (change to your server's IP or domain)
GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9000/
