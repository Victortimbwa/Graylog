# docker-compose.override.yml
# This is an example override file for production deployments
# Copy this to docker-compose.override.yml and customize as needed
#
# Docker Compose automatically merges docker-compose.yml with 
# docker-compose.override.yml when running commands

services:
  mongodb:
    # Production: Use specific version and add resource limits
    # image: mongo:6.0.13
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 2G
        reservations:
          cpus: '1'
          memory: 1G
    # Production: Add health check
    healthcheck:
      test: echo 'db.runCommand("ping").ok' | mongosh localhost:27017/test --quiet
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  elasticsearch:
    # Production: Increase memory and add resource limits
    environment:
      - "ES_JAVA_OPTS=-Xms2g -Xmx2g"
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 4G
        reservations:
          cpus: '2'
          memory: 2G
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9200/_cluster/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  graylog:
    # Production: Add resource limits and additional environment variables
    environment:
      - GRAYLOG_HTTP_PUBLISH_URI=${GRAYLOG_HTTP_PUBLISH_URI:-http://graylog.example.com:9000/}
      - GRAYLOG_MESSAGE_JOURNAL_MAX_SIZE=5gb
      - GRAYLOG_PROCESSBUFFER_PROCESSORS=5
      - GRAYLOG_OUTPUTBUFFER_PROCESSORS=3
      - GRAYLOG_RING_SIZE=65536
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 4G
        reservations:
          cpus: '2'
          memory: 2G
    # Production: Add more input ports as needed
    # ports:
    #   - "5044:5044"     # Beats
    #   - "5140:5140/udp" # Raw/Plaintext UDP
    #   - "5555:5555/tcp" # Raw/Plaintext TCP

# Production: Use external volumes or bind mounts for data persistence
# volumes:
#   mongodb_data:
#     driver: local
#     driver_opts:
#       type: none
#       o: bind
#       device: /data/graylog/mongodb
#   elasticsearch_data:
#     driver: local
#     driver_opts:
#       type: none
#       o: bind
#       device: /data/graylog/elasticsearch
#   graylog_data:
#     driver: local
#     driver_opts:
#       type: none
#       o: bind
#       device: /data/graylog/graylog
